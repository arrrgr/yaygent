# Comma-separated list of accepted X-API-Key values. Required.
YAYGENT_API_KEY=
# Required only when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Search: Serper is the only real search backend (Google over proxies never returns a SERP).
# Missing key -> Google News RSS (news queries) / Bing HTML over the proxy only.
SERPER_API_KEY=
SERPER_QPS=5

# Jina Reader (fetch tier 3). Unkeyed is ~20 RPM; keyed is ~10x higher.
JINA_API_KEY=
# Default 15 unkeyed, 150 when JINA_API_KEY is set.
JINA_RPM=

# Webshare rotating gateway (`<user>-rotate`). Used for target-site fetches and the Bing fallback only.
# Playwright derives sticky sessions (`<user>-1`..`-10`) from it, one per page.
PROXY_URL_ROTATE=
# Legacy fallback when PROXY_URL_ROTATE is unset.
PROXY_URL=

# Fetch: one total budget per visit across all tiers (direct 5s -> proxy 2x5s -> Jina 8s -> Playwright).
FETCH_BUDGET_MS=15000
# Concurrent JSDOM/Readability parses (the OOM path).
PARSE_CONCURRENCY=8
# Per-host concurrency for direct/proxy/Playwright tiers; tolerant hosts (linkedin, crunchbase, bing, news wires) get the higher cap.
HOST_LIMIT=2
HOST_TOLERANT_LIMIT=8
# Shortest markdown a tier may return as success; below it the fetch escalates to the next tier.
MIN_CONTENT_CHARS=120

# Set to 0 for pure HTTP/Jina operation with no local Playwright browser (acceptance runs use 0).
BROWSER_POOL_SIZE=0
WORKER_CONCURRENCY=40
LOG_LEVEL=info
PORT=3000

# --- v2 cycle engine ---
# openrouter | anthropic | claude_code (see src/llm/index.ts)
LLM_PROVIDER=openrouter
ANTHROPIC_API_KEY=
# Claude Code CLI provider: binary path + max parallel spawns
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_CONCURRENCY=4
# Supavisor session pooler URL; unset = in-process caches only, no profile_cache tier
YAYGENT_DATABASE_URL=
# Part of the result cache key; Railway sets RAILWAY_GIT_COMMIT_SHA automatically
CODE_VERSION=

# Apify token for the `profile_scrape` strategy (LinkedIn profile detail, cached in
# public.linkedin_profiles). Unset = that strategy is skipped silently.
APIFY_API_TOKEN=

# Optional enum classification strategy; skipped when absent.
JEV_API_KEY=
# Local CLI reasoning effort.
CLAUDE_CODE_EFFORT=low
# Optional path to an existing Chromium executable when browser pool > 0.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Batch memory guard budget in MB; defaults to 512.
RAILWAY_MEMORY_MB=512
